{
  "name": "hecagus-finance",
  "version": "3.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-hecagus-audit \"node --test tests/rules/*.test.js\"",
    "android:web": "node scripts/build-android-web.mjs",
    "android:sync": "npm run android:web && cap sync android && node scripts/prepare-android.mjs",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@firebase/rules-unit-testing": "^5.0.2",
    "esbuild": "0.25.12",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.32.0",
    "jsdom": "^30.1.1"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "8.5.2",
    "@capacitor/android": "8.5.2",
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "8.5.2"
  }
}
